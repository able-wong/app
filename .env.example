# base64 encoded public key for JWT authentication
JWT_PUBLIC_KEY_BASE64=...

# base64 encoded private key for JWT authentication
JWT_PRIVATE_KEY_BASE64=...

# algorithm for JWT authentication.
# it should not be changed.
JWT_ALGORITHM=RS256

# expiration time for JWT token
JWT_EXPIRES_IN=3600

MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_HOST=myapp-test-mysql
MYSQL_PORT=3306
MYSQL_USER=myappuser
MYSQL_PASSWORD=myapppassword
MYSQL_DATABASE=myappdb
